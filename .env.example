# ==============================================================================
# AgentV / AES Evaluation Harness - Environment Configuration Examples
# ==============================================================================
# Copy this file to .env and configure the variables according to your deployment.
# Sensitive secrets (API keys, private keys, JWT secrets) MUST NOT be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & CONSOLE SECURITY
# ------------------------------------------------------------------------------
# Execution environment: 'development' (default) or 'production'.
# In 'production', missing keys or missing UI bundle will FAIL-CLOSED.
AGENTV_ENV=development

# ------------------------------------------------------------------------------
# AUTHENTICATION & SESSION CREDENTIALS
# The evaluation harness uses distinct keys for human operators, automation,
# browser session encryption, and delegated JWT token issuance.
#
# QUICK DIFFERENTIATION MATRIX:
# +-------------------+-----------------------+----------------------------------+-----------------------------+
# | Variable          | Intended Audience     | Primary Mechanism / Protocol     | Fallback / Default Chain    |
# +-------------------+-----------------------+----------------------------------+-----------------------------+
# | DASHBOARD_API_KEY | Human Operators       | Web Console UI & Admin REST API  | -> SERVICE_API_KEY          |
# |                   |                       | (Header: X-API-Key or /login)    | -> .aes/keys/bootstrap.key  |
# +-------------------+-----------------------+----------------------------------+-----------------------------+
# | SERVICE_API_KEY   | Automation / Machines | CI/CD Runners & Background Tasks | Used as fallback for        |
# |                   |                       | (Header: X-API-Key / Bearer)     | DASHBOARD_API_KEY           |
# +-------------------+-----------------------+----------------------------------+-----------------------------+
# | SECRET_KEY        | Flask Web Runtime     | HMAC Cookie Signing (Server-side)| -> SHA3-256(JWT_SECRET or   |
# |                   |                       | (app.secret_key cookie encrypt)  |    DASHBOARD/SERVICE key)   |
# +-------------------+-----------------------+----------------------------------+-----------------------------+
# | JWT_SECRET        | Token Handoff / Auth  | JWT Token Signature (HS256)      | -> DASHBOARD_API_KEY        |
# |                   |                       | (/api/auth/handoff bearer token) | -> SERVICE_API_KEY          |
# +-------------------+-----------------------+----------------------------------+-----------------------------+
#
# 1. DASHBOARD_API_KEY (Human / Operator Access):
#    - Purpose: Primary authentication key for the Visual Console UI and interactive REST API.
#    - Target: Human engineers, web browser logins, and operator administration.
#    - Protocol: Provided via 'X-API-Key: <key>' header or submitted at '/api/auth/login'.
#    - Behavior: Required in production (AGENTV_ENV=production). In development, if unset,
#      a zero-config key is automatically generated in .aes/keys/bootstrap.key.
#    - Generation: python -c "import secrets; print(secrets.token_hex(32))"
# DASHBOARD_API_KEY=
#
# 2. SERVICE_API_KEY (Machine / Automation Access):
#    - Purpose: Machine-to-machine programmatic key for headless and automated execution.
#    - Target: CI/CD runners (GitHub Actions/GitLab), background daemons, and scheduled workers.
#    - Protocol: Provided via 'X-API-Key: <key>' or 'Authorization: Bearer <key>' headers.
#    - Behavior: Segregates automated workflows from human operator credentials, allowing
#      independent key rotation without disrupting interactive dashboard sessions.
#      If DASHBOARD_API_KEY is omitted, the console server gracefully falls back to this key.
#    - Generation: python -c "import secrets; print(secrets.token_hex(32))"
# SERVICE_API_KEY=
#
# 3. SECRET_KEY (Flask Session Cookie Encryption):
#    - Purpose: Server-side cryptographic secret for signing and encrypting browser cookies.
#    - Target: Flask web runtime (app.secret_key) for tamper-proof session persistence.
#    - Protocol: Internal server-side only; never transmitted across the network.
#    - Behavior: Critical in multi-worker or containerized deployments (e.g. Gunicorn/K8s) to
#      ensure session cookies can be validated across different processes and replicas.
#      If unset, derived from JWT_SECRET, DASHBOARD_API_KEY, or SERVICE_API_KEY via SHA3-256 checksum.
#    - Generation: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=
#
# 4. JWT_SECRET (Token Handoff & Delegated Auth):
#    - Purpose: Cryptographic signing secret specifically for JSON Web Tokens (JWT).
#    - Target: Console extension handoff tokens (/api/auth/handoff), short-lived bearer
#      tokens, and micro-frontend delegated authorization claims.
#    - Protocol: Used to sign and verify HS256 JWT signatures for delegated bearer tokens.
#    - Behavior: In production, must be explicitly configured to prevent per-process
#      ephemeral key generation (which causes tokens issued by worker A to fail on worker B).
#      If unset, falls back to DASHBOARD_API_KEY or SERVICE_API_KEY.
#    - Generation: python -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET=

# Allowed CORS origins for Visual Console API (comma-separated).
# When unset or empty, the console enforces strict same-origin only (no CORS headers emitted).
# Example: AGENTV_ALLOWED_ORIGINS=http://localhost:5173,https://console.example.com
AGENTV_ALLOWED_ORIGINS=

# Enforce secure (HTTPS-only) session cookies (automatically true if AGENTV_ENV=production).
AGENTV_SECURE_COOKIES=false

# Evaluator system identity key auto-provisioning guard.
# Disallows unauthenticated/automatic minting of evaluator signing keys when set to false.
ALLOW_SYSTEM_IDENTITY_PROVISIONING=false

# Trusted publisher identities for manifest verification (comma-separated IDs).
# AGENTV_OFFICIAL_PUBLISHERS=

# Enterprise OpenID Connect (OIDC) / SSO Configuration (optional)
# OIDC_ISSUER=https://auth.example.com
# OIDC_AUDIENCE=agentv-eval-harness
# OIDC_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# OIDC_JWKS_CACHE_TTL=3600


# ------------------------------------------------------------------------------
# 2. AGENT CONNECTIVITY & ADAPTER PROTOCOLS
# ------------------------------------------------------------------------------
# The primary HTTP URL where the evaluation engine communicates with the agent adapter.
AGENT_API_URL=http://localhost:5001/execute_task

# Comma-separated list of fallback agent endpoints for resilient failover / load-balancing.
AGENT_API_URLS=http://localhost:5001/execute_task

# Alternative execution modes: Local subprocess CLI command or Unix/TCP socket address.
# AGENT_LOCAL_CMD=python -m my_agent.cli
# AGENT_SOCKET_ADDR=tcp://127.0.0.1:9099

# Adapter HTTP timeouts and retry resilience
ADAPTER_TIMEOUT=30.0
ADAPTER_MAX_RETRIES=3
ADAPTER_RETRY_DELAY=1.0

# AG2 (formerly AutoGen) Adapter Configuration
AG2_API_URL=http://localhost:5002/execute_task
AG2_USE_DOCKER=false

# Path to reusable agent targets registry (connect-once, reuse across scenarios)
AGENT_TARGETS_PATH=.aes/agent_targets.json

# OpenAPI / External Tool Adapter Authentication (optional)
# OPENAPI_CLIENT_ID=
# OPENAPI_CLIENT_SECRET=
# OPENAPI_TOKEN=
# OPENAPI_TOKEN_URL=


# ------------------------------------------------------------------------------
# 3. EVALUATION EXECUTION & ENGINE RUNTIME
# ------------------------------------------------------------------------------
# Maximum interactive conversation turns per scenario before capping.
EVAL_MAX_TURNS=10

# Global execution timeout per evaluation run (in seconds).
RUN_TIMEOUT_SECONDS=120

# Maximum attempts ceiling for pass@k evaluations.
MAX_ENGINE_ATTEMPTS=50

# Forking & Session tree limits for complex multi-branch evaluations.
MAX_FORK_DEPTH=3
MAX_FORK_BREADTH=5

# Seconds to throttle between agent turns (protects against upstream rate limits).
EVAL_TURN_THROTTLE=0.0

# Authoritative routing strategy: 'Priority_Standard', etc.
EVAL_ROUTING_STRATEGY=Priority_Standard

# Enable Human-in-the-Loop (HITL) pause, inspection, and manual override checkpoints.
ENABLE_HITL=true


# ------------------------------------------------------------------------------
# 4. LLM JUDGE & MODEL PROVIDERS
# ------------------------------------------------------------------------------
# Active LLM provider for the semantic evaluation judge: 'ollama', 'openai', 'anthropic', 'gemini', 'grok'.
JUDGE_PROVIDER=ollama
JUDGE_MODEL=llama4

# Judge sampling temperature (0.0 for deterministic, reproducible scoring).
LUNA_JUDGE_TEMPERATURE=0.0

# Maximum completion tokens for judge evaluations.
LLM_MAX_TOKENS=1024
DEFAULT_LLM_TIMEOUT=10

# LLM Resilience & Exponential Backoff Knobs
AGENTV_LLM_MAX_RETRIES=4
AGENTV_LLM_INITIAL_DELAY=1.0
AGENTV_LLM_MAX_DELAY=30.0
AGENTV_LLM_BACKOFF_FACTOR=2.0

# --- Local Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama4
OLLAMA_API_URL=http://localhost:11434/api/chat

# --- OpenAI Provider ---
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6

# --- Anthropic Provider ---
# ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_VERSION=2023-06-01

# --- Google Gemini Provider ---
# GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1/models
GEMINI_MODEL=gemini-3.7-flash

# --- xAI Grok Provider ---
# XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.20-multi-agent


# ------------------------------------------------------------------------------
# 5. CRYPTOGRAPHIC IDENTITY, FLIGHT RECORDER & ATTESTATION
# ------------------------------------------------------------------------------
# Two Core signing keys — recommended practice is one Ed25519 key pair serving both:
#
# FLIGHT_RECORDER_KEY_PATH — path to private PEM key used by FlightRecorder to sign
#   every run event in real-time as a tamper-evident streaming hash-chain.
# CORE_ARTIFACT_SIGNING_PEM — inline PEM private key string used by ArtifactPlugin to sign
#   post-run artifact bundles and formal verification certificates.
#
# Generate an Ed25519 key pair:
#   python -c "from cryptography.hazmat.primitives.asymmetric import ed25519; from cryptography.hazmat.primitives import serialization; import os; os.makedirs('.aes/keys', exist_ok=True); k=ed25519.Ed25519PrivateKey.generate(); open('.aes/keys/system_id.pem','wb').write(k.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption())); print('Key written to .aes/keys/system_id.pem')"
#
# FLIGHT_RECORDER_KEY_PATH=.aes/keys/system_id.pem
# CORE_ARTIFACT_SIGNING_PEM=

# Root directory containing public keys and identity trust anchors.
TRUST_ROOT=.aes/keys

# Authoritative policy reference ID stamped into certificates (e.g. NIST-AI-100-1).
TRUSTED_POLICY_REF=NIST-AI-100-1

# Fail-closed signing: Abort evaluation if cryptographic signing of events fails.
EVAL_SIGNING_FAIL_CLOSED=true

# Require valid cryptographic signatures for doctor / health verification checks.
EVAL_REQUIRE_SIGNING=false

# Strict certification verification mode (enforces tamper-evident artifact seals).
AES_CERTIFICATION_MODE=0

# --- Post-Quantum Cryptography (PQC) ---
# Enable Hybrid Classical + PQC Signing (ED25519 + ML-DSA-65).
PQC_ENABLED=false
PQC_PROVIDER=cyclecore
# CycleCore ZES API Key (Required if PQC_ENABLED=true)
# CYCLECORE_API_KEY=
CYCLECORE_IDENTITY_ID=agentv_test_identity
PQC_STRICT_MODE=false


# ------------------------------------------------------------------------------
# 6. TRACE PERSISTENCE, EVIDENCE VAULTS & AUDIT LOGS
# ------------------------------------------------------------------------------
# Root directory where trace files, event logs, and evidence vaults are saved.
RUN_LOG_DIR=runs

# Write isolated per-run traces (e.g. runs/<run_id>.jsonl). NEVER rotated.
RUN_LOG_PER_RUN=true

# Maintain a consolidated master trace append log (runs/runs.jsonl).
RUN_LOG_MASTER=true

# Number of records to retain in master runs.jsonl before rotation.
RUN_LOG_MASTER_LIMIT=300

# Number of rotated master logs to keep on disk (0 = overwrite).
RUN_LOG_ROTATE_COUNT=0

# Destination directory for HTML, Markdown, and Trajectory audit reports.
REPORTS_DIR=reports

# Telemetry and audit depth: 1 = Basic runtime events, 2 = Full forensic evidence graph.
AUDIT_LEVEL=2


# ------------------------------------------------------------------------------
# 7. TOOL SANDBOXING & SHIM ISOLATION
# ------------------------------------------------------------------------------
# Comma-separated list of globally enabled tool shims (* for all).
GLOBAL_ENABLED_SHIMS=git,api,database,slack,crm,email,calendar,jira,cloud,terminal,stripe,erp,browser,kb,support,social,vector,cicd,iot,security

# Virtual Filesystem (VFS) prefix for sandboxed paths.
SANDBOX_VFS_PREFIX=vfs:/

# Execution timeout in seconds for individual tool shims.
SHIM_TIMEOUT=30.0

# Execution timeout in seconds for lifecycle plugins.
PLUGIN_TIMEOUT=5.0

# Fail closed if third-party or custom plugins fail to load.
STRICT_PLUGINS=false

# Enforce strict jail: Restrict tool execution strictly to project .tmp sandbox,
# completely blocking OS temporary directory access (set to 1 to enable).
# AEH_STRICT_JAIL=0


# ------------------------------------------------------------------------------
# 8. OPENTELEMETRY & OBSERVABILITY
# ------------------------------------------------------------------------------
# OpenTelemetry service name attached to all runtime spans.
OTEL_SERVICE_NAME=agentv-core

# Remote OTLP Collector endpoint (gRPC / HTTP). If unset, OTel export is disabled.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317


# ------------------------------------------------------------------------------
# 9. CODEBASE ANALYSIS & REPOSITORY INGESTION
# ------------------------------------------------------------------------------
# GitHub Personal Access Token for remote repository analysis.
# Falls back to GITHUB_TOKEN or GH_TOKEN if unset.
# AGENTV_REPO_TOKEN=

# Comma-separated allowed Git host domains (empty allows all).
AGENTV_ANALYZER_ALLOWED_HOSTS=

# Concurrency workers for repo tree parsing.
AGENTV_ANALYZER_CONCURRENCY=8

# Soft deadline in seconds for codebase analysis.
AGENTV_ANALYZER_DEADLINE_S=90

# Maximum file budget to explore during repository tree analysis.
AGENTV_ANALYZER_FILE_BUDGET=500

# Total byte ingestion budget (default: 25MB = 26214400 bytes).
AGENTV_ANALYZER_MAX_BYTES=26214400


# ------------------------------------------------------------------------------
# 10. VISUAL SUITE & DIAGNOSTICS
# ------------------------------------------------------------------------------
# Enable built-in demo scenarios and synthetic traces in the console.
ENABLE_DEMO=false

# Enable diagnostics debug buttons and verbose path logging.
DEBUG=false
DEBUG_PATHS=false
