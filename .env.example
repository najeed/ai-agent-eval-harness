# AES Evaluation Harness - Environment Configuration Template
# Template configuration for the AgentV Harness.
# Rename this file to .env and fill in your credentials.

# --- Agent Connectivity ---
# The URL where the engine can reach your agent adapter.
# For Docker Compose, the default service name is 'agent'.
AGENT_API_URL=http://localhost:5001/execute_task

# --- Evaluation Parameters ---
# Number of turns in a single conversation before capping.
EVAL_MAX_TURNS=10
# Default industry tag if none is provided in the scenario.
DEFAULT_INDUSTRY=telecom

# --- LLM Judge Layer ---
# Supported providers: ollama, openai, anthropic, gemini, grok
JUDGE_PROVIDER=ollama
JUDGE_MODEL=llama4

# --- Provider Hosts ---
OLLAMA_HOST=http://localhost:11434
AG2_API_URL=http://localhost:5002/execute_task

# --- Dashboard & Console Security ---
# Dashboard API Key for sensitive execution (REST API / Console).
# MANDATORY for production. Use python -c "import secrets; print(secrets.token_hex(32))"
# Under the hood, this key is derived using SHA3-256.
# DASHBOARD_API_KEY=
# Service API Key for programmatic / CLI access.
# If not set, it will fallback to DASHBOARD_API_KEY for compatibility.
# SERVICE_API_KEY=

# --- Cryptographic Identity (Core) ---
# Two Core signing vars — best practice is one Ed25519 key pair serving both:
#
# CORE_ARTIFACT_SIGNING_PEM  — inline PEM string. Used by ArtifactPlugin to sign
#   post-run artifact bundles and verification certificates.
# FLIGHT_RECORDER_KEY_PATH — file path to PEM key. Used by FlightRecorder to sign
#   every run event as it is recorded (streaming, per-event tamper-evidence).
#
# Generating one key pair for both:
#   python -c "from cryptography.hazmat.primitives.asymmetric import ed25519; from cryptography.hazmat.primitives import serialization; import os; os.makedirs('.aes/keys', exist_ok=True); k=ed25519.Ed25519PrivateKey.generate(); open('.aes/keys/system_id.pem','wb').write(k.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption())); print('Key written to .aes/keys/system_id.pem')"
# Then set:
#   FLIGHT_RECORDER_KEY_PATH=.aes/keys/system_id.pem
#   CORE_ARTIFACT_SIGNING_PEM=$(cat .aes/keys/system_id.pem)   # or paste PEM inline
# CORE_ARTIFACT_SIGNING_PEM=
# FLIGHT_RECORDER_KEY_PATH=.aes/keys/system_id.pem

# --- Post-Quantum Cryptography (PQC) ---
# Enable Hybrid PQC Signing (ED25519 + ML-DSA-65).
PQC_ENABLED=false
# Supported providers: cyclecore
PQC_PROVIDER=cyclecore
# CycleCore ZES API Key (Required if PQC_ENABLED=true)
# CYCLECORE_API_KEY=
# CycleCore Identity ID to use for signing.
CYCLECORE_IDENTITY_ID=agentv_test_identity
# If true, fail evaluation if PQC signing fails.
PQC_STRICT_MODE=false

# --- Propagation & Throttling ---
# Seconds to wait between agent turns (useful for rate-limited APIs).
# EVAL_TURN_THROTTLE=0.0
# Number of traces to maintain in runs.jsonl before it gets rotated.
# Individual trace files (e.g. runs/uuid.jsonl) are NEVER rotated.
RUN_LOG_MASTER_LIMIT=300

# --- API Keys (Uncomment and fill to use proprietary models) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# XAI_API_KEY=

# --- Feature Flags ---
# Enable the built-in demo traces in the console.
ENABLE_DEMO=false
# Comma-separated list of globally enabled tool shims (* for all).
GLOBAL_ENABLED_SHIMS=git,api,database,slack,crm,email,calendar,jira,cloud,terminal,stripe,erp,browser,kb,support,social,vector,cicd,iot,security
# Enable the diagnostics debug toggle button in the console.
DEBUG=false
