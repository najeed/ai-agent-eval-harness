{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AES Root Schema (v1.4.0)",
  "type": "object",
  "required": [
    "aes_version",
    "metadata",
    "workflow",
    "evaluation"
  ],
  "properties": {
    "aes_version": {
      "type": "number",
      "enum": [
        1.4
      ]
    },
    "metadata": {
      "$ref": "definitions/metadata.json"
    },
    "workflow": {
      "$ref": "definitions/workflow.json"
    },
    "evaluation": {
      "$ref": "definitions/evaluation.json"
    },
    "initial_state": {
      "type": "object"
    },
    "environmental_snapshot": {
      "type": "object"
    },
    "enabled_shims": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Explicit whitelist of world simulators to activate."
    },
    "tools": {
      "type": "object",
      "description": "Declared scenario tool manifest with deterministic outcomes and state mutations."
    },
    "failure_policy": {
      "type": "string",
      "enum": [
        "fail_fast",
        "continue_independent",
        "compensate_then_fail",
        "best_effort"
      ]
    },
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "use_case": {
      "type": "string"
    },
    "cleanup_workspace": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}