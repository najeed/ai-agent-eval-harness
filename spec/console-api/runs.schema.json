{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "spec/console-api/runs.schema.json",
  "title": "GET /api/runs",
  "description": "Locked response contract for the runs listing. Every row carries a server-authoritative verification verdict and trace-integrity badge.",
  "type": "object",
  "required": ["runs"],
  "additionalProperties": false,
  "properties": {
    "runs": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["verification_status", "trace_integrity"],
        "properties": {
          "verification_status": {
            "enum": [
              "VERIFIED",
              "FAILED_VERIFICATION",
              "NOT_EXECUTED",
              "ERROR",
              "UNKNOWN"
            ]
          },
          "trace_integrity": {
            "enum": ["COMPLETE", "PARTIAL", "RECOVERED"]
          }
        }
      }
    }
  }
}
