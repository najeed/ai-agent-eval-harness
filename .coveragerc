[run]
source =
    eval_runner
    dataproc_engine
omit =
    dataproc_engine/tests/*
    sample_agent/*
    eval_runner/console/demo_logic.py
    eval_runner/console/gen_demo_assets.py
    eval_runner/console/routes/demo.py
    # Optional framework adapters are independently dependency-certified.
    eval_runner/adapters/ag2.py
    eval_runner/adapters/crewai.py
    eval_runner/adapters/grok.py
    eval_runner/adapters/langchain.py
    eval_runner/adapters/langgraph.py
    eval_runner/adapters/ollama.py
    eval_runner/adapters/openapi.py
    tests/*
    tools/*
    */__init__.py
    */__main__.py

[report]
show_missing = True
precision = 2
fail_under = 90
omit =
    eval_runner/adapters/ag2.py
    eval_runner/adapters/crewai.py
    eval_runner/adapters/grok.py
    eval_runner/adapters/langchain.py
    eval_runner/adapters/langgraph.py
    eval_runner/adapters/ollama.py
    eval_runner/adapters/openapi.py
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if __name__ == .__main__.:
    raise AssertionError
    raise NotImplementedError
    if TYPE_CHECKING:
    pass
