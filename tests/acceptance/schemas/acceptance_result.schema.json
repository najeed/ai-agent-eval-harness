      }
    },
    "run_id": {
      "type": "string"
    },
    "agentv_version": {
      "type": "string"
    },
    "git_commit": {
      "type": "string"
    },
    "evidence_verified": {
      "type": "boolean"
    },
    "certificate_verified": {
      "type": "boolean"
    },
    "ledger_verified": {
      "type": "boolean"
    }
