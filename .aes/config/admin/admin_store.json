  "notification_rules": [
    {
      "id": "rule_01",
      "name": "Critical Security Violations",
      "event_type": "security.policy_violation",
      "severity": "CRITICAL",
      "channels": [
        "chan_pagerduty",
        "chan_slack_sec",
        "chan_webhook_siem"
      ],
      "enabled": true,
      "escalation_minutes": 15
    },
    {
      "id": "rule_02",
      "name": "Compliance Framework Score Drop (<90%)",
      "event_type": "compliance.framework_score_drop",
      "severity": "HIGH",
      "channels": [
        "chan_slack_sec",
        "chan_email_compliance"
      ],
      "enabled": true,
      "escalation_minutes": 60
    },
    {
      "id": "rule_03",
      "name": "HITL Triage Pending SLA Breach (>30m)",
      "event_type": "hitl.pending_sla_breach",
      "severity": "HIGH",
      "channels": [
        "chan_slack_sec",
        "chan_pagerduty"
      ],
      "enabled": true,
      "escalation_minutes": 30
    },
    {
      "id": "rule_04",
      "name": "Fleet Statistical Drift Regression",
      "event_type": "drift.regression_detected",
      "severity": "MEDIUM",
      "channels": [
        "chan_slack_sec"
      ],
      "enabled": true,
      "escalation_minutes": 120
    },
    {
      "id": "rule_05",
      "name": "Credential Rotation Reminder (Overdue)",
      "event_type": "admin.secret_rotation_due",
      "severity": "MEDIUM",
      "channels": [
        "chan_email_compliance"
      ],
      "enabled": true,
      "escalation_minutes": 240
    }
  ],
